APP_NAME=KARSA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=karsa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@karsa.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ==== KARSA: sumber data hotspot ====
# Endpoint internal SiPongi+ (KLHK) -- WAJIB diverifikasi lewat DevTools sebelum dipakai di produksi.
# Lihat CLAUDE.md §8.1. Kosongkan untuk menonaktifkan dan langsung memakai FIRMS.
SIPONGI_HOTSPOT_URL=
SIPONGI_EXTRA_PARAMS=
SIPONGI_USER_AGENT="KARSA/1.0 (SMAN 1 Ciruas; kontak@karsa.local)"

# NASA FIRMS -- daftar gratis di https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# BMKG (pelengkap cuaca, tanpa kunci, dibatasi laju permintaan)
BMKG_BASE_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca

# Open-Meteo (utama, tanpa kunci)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ==== KARSA: Web Push (VAPID) ====
# Buat dengan: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:kontak@karsa.local"

# ==== KARSA: Login dengan Google (Socialite) ====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ==== KARSA: akun superadmin awal (dipakai seeder) ====
SUPERADMIN_NAME="Admin KARSA"
SUPERADMIN_EMAIL=admin@karsa.local
SUPERADMIN_PASSWORD=ubahsegera123

# ==== KARSA: kontak & metadata ====
KARSA_CONTACT_EMAIL=kontak@karsa.local

# ==== KARSA: Google Gemini AI ====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
