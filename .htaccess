<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    DirectoryIndex public/index.php index.php

    RewriteEngine On
    RewriteBase /

    # 1. Jika mengakses halaman utama "/", langsung jalankan public/index.php
    RewriteRule ^$ public/index.php [L]

    # 2. Arahkan file statis / aset fisik ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 3. Arahkan seluruh rute aplikasi ke public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
